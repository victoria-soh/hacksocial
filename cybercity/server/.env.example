# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Anthropic API key, used server-side only by POST /api/ai/complete to power
# the three AI features (Digital Breadcrumbs self-exposure analysis,
# Recovery Rush mistake explanations, Phase 4 bonus-round content
# generation). Get one at https://console.anthropic.com/.
#
# If this is left unset, /api/ai/complete returns 503 and every AI feature
# automatically falls back to its deterministic local heuristic — the app
# is fully playable either way, this just controls whether the "real AI"
# path is available.
ANTHROPIC_API_KEY=

# Port the Express server listens on. Optional — most hosts (Render,
# Railway) set this automatically; only needed for local dev if you want a
# non-default port. Defaults to 8787.
PORT=8787

# Comma-separated list of extra origins allowed to call this API via CORS,
# e.g. https://cybercity.example.com — set this to your deployed frontend's
# URL in production. localhost (any port) is ALWAYS allowed regardless of
# this value, for local dev. Left unset, no origins beyond localhost are
# allowed — an open CORS policy is a real exposure once this is actually
# deployed, so (unlike the AI key) this doesn't quietly default open.
ALLOWED_ORIGINS=

# Where the SQLite file lives. Optional — defaults to cybercity.sqlite next
# to server/db.js, which works fine locally but is WIPED on every redeploy
# on a host without persistent disk (see server/README.md's "Deploying"
# section for the tradeoff). Only set this if you've attached a persistent
# disk/volume and want the DB stored there instead, e.g.:
#   DB_PATH=/data/cybercity.sqlite
DB_PATH=
