# Copy this file to .env and adjust if needed. .env is gitignored.

# Base URL of the CyberCity backend (server/). Optional for local dev —
# defaults to http://localhost:8787 if unset (see src/lib/api.js). Only
# needs to be set here when deploying the frontend, pointing it at your
# deployed backend's URL, e.g.:
#   VITE_API_URL=https://cybercity-api.onrender.com
#
# The backend is entirely optional: without it (or with this pointed at a
# backend that's down), CyberCity still works fully — progress just stays
# on this device instead of syncing via a shareable code, and the three AI
# features fall back to their local heuristics instead of a live model.
VITE_API_URL=
